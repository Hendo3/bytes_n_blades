{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "locale", "classes", "programs"],
  "properties": {
    "schema_version": { "type": "string" },
    "locale": { "enum": ["en-US", "pt-BR"] },
    "classes": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "programs": {
      "type": "array",
      "minItems": 160,
      "items": { "$ref": "#/definitions/program" }
    }
  },
  "definitions": {
    "strength": {
      "type": "object",
      "anyOf": [
        { "required": ["base"] },
        { "required": ["display"] }
      ],
      "properties": {
        "base": { "type": "integer", "minimum": 0 },
        "display": { "type": "string", "minLength": 1 },
        "situational": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "when"],
            "properties": {
              "value": { "type": "integer" },
              "when": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["fixed", "variable", "formula", "per_cpu", "not_for_sale"] },
        "amount": { "type": "number", "minimum": 0 },
        "base": { "type": "number", "minimum": 0 },
        "per_strength": { "type": "number", "minimum": 0 },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["book", "pages"],
      "properties": {
        "book": { "type": "string", "minLength": 1 },
        "pages": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "program": {
      "type": "object",
      "required": ["id", "class_id", "class_ids", "name", "strength", "memory", "memory_model", "price", "price_model", "effect", "platform", "loadable", "availability", "catalog_scope", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "class_id": { "type": "string", "minLength": 1 },
        "class_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "name": { "type": "string", "minLength": 1 },
        "strength": { "$ref": "#/definitions/strength" },
        "memory": { "type": ["integer", "null"], "minimum": 0 },
        "memory_model": { "$ref": "#/definitions/model" },
        "price": { "type": ["number", "null"], "minimum": 0 },
        "price_model": { "$ref": "#/definitions/model" },
        "effect": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "platform": { "enum": ["cyberdeck", "data_fortress", "mainframe", "ai"] },
        "loadable": { "type": "boolean" },
        "availability": { "enum": ["retail", "restricted", "quote", "not_for_sale", "referee_approval"] },
        "catalog_scope": { "enum": ["standard", "netrunner_conversion"] },
        "capacity": { "type": "integer", "minimum": 1 },
        "demon_capacity": { "type": "integer", "minimum": 1 },
        "copy_restricted": { "type": "boolean" },
        "copy_restriction": { "type": "string" },
        "source": { "$ref": "#/definitions/source" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
