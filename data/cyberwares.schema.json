{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cyberwares Dataset",
  "type": "object",
  "required": ["data"],
  "properties": {
    "$id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "author": { "type": "string" },
    "date": { "type": "string" },
    "data": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Description": { "type": "string" },
          "description": { "type": "string" },
          "name": { "type": "string" },
          "types": { "type": "object" },
          "modifiers": { "type": "object" },
          "itens": { "$ref": "#/definitions/itemMap" },
          "items": { "$ref": "#/definitions/itemMap" },
          "list": { "$ref": "#/definitions/itemMap" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "itemMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/item" }
    },
    "item": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "note": { "type": "string" },
        "effect": { "type": "string" },
        "price": { "type": ["string", "number"] },
        "cost": { "type": ["string", "number"] },
        "value": { "type": ["string", "number"] },
        "HL": { "type": ["string", "number"] },
        "hl": { "type": ["string", "number"] },
        "humanity": { "type": ["string", "number"] },
        "surg": { "type": "string" },
        "CIR": { "type": "string" },
        "cir": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "maxPurchases": {
          "type": "integer",
          "minimum": 1
        },
        "alternativeAcquisition": { "type": "boolean" },
        "attributeBonuses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["attribute", "value"],
            "properties": {
              "attribute": { "type": "string" },
              "value": { "type": "number" },
              "mode": {
                "type": "string",
                "enum": ["flat", "percent"]
              },
              "scope": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "skillBonuses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["skill", "value"],
            "properties": {
              "skill": { "type": "string" },
              "value": { "type": "number" },
              "mode": {
                "type": "string",
                "enum": ["flat", "percent"]
              },
              "scope": { "type": "string" },
              "note": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "attributeSet": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string"]
          }
        },
        "priceModifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "value"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["multiplier", "additive", "override"]
              },
              "value": { "type": "number" },
              "condition": { "type": "string" },
              "note": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "installation": {
          "type": "object",
          "properties": {
            "requires": {
              "type": "array",
              "items": { "type": "string" }
            },
            "requiresAny": {
              "type": "array",
              "items": { "type": "string" }
            },
            "slotProvider": { "type": "string" },
            "slotFamily": { "type": "string" },
            "slotCapacity": { "type": "integer", "minimum": 0 },
            "slotUsage": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
