{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prebuilt Cyberdeck Dataset",
  "type": "object",
  "required": ["$id", "title", "version", "type", "data"],
  "properties": {
    "$id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "type": { "const": "prebuilt-cyberdecks" },
    "data": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/category" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "category": {
      "type": "object",
      "required": ["name", "description", "items"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "items": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/deck" }
        }
      },
      "additionalProperties": false
    },
    "deck": {
      "type": "object",
      "required": [
        "id",
        "name",
        "manufacturer",
        "model",
        "description",
        "price",
        "approximatePrice",
        "stats",
        "features",
        "options",
        "source"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "price": { "type": "number", "minimum": 0 },
        "approximatePrice": { "type": "boolean" },
        "stats": {
          "type": "object",
          "required": ["speed", "memoryUnits"],
          "properties": {
            "speed": { "type": "integer", "minimum": 0, "maximum": 5 },
            "cpu": { "type": "integer", "minimum": 1 },
            "memoryUnits": { "type": "integer", "minimum": 1 },
            "dataWall": { "type": "integer", "minimum": 0, "maximum": 10 }
          },
          "additionalProperties": false
        },
        "features": {
          "type": "object",
          "required": ["cellular", "portable"],
          "properties": {
            "cellular": { "type": "boolean" },
            "portable": { "type": ["boolean", "null"] }
          },
          "additionalProperties": false
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "label": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "source": {
          "type": "object",
          "required": ["bookId", "book", "page"],
          "properties": {
            "bookId": { "const": "cp2020-corebook" },
            "book": { "type": "string", "minLength": 1 },
            "page": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
