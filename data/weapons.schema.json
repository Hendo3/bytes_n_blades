{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/fnff/weapons-store.schema.json",
  "title": "FNFF Weapon Store",
  "type": "object",
  "required": ["version", "weapons"],
  "properties": {
    "version": {"const": 1},
    "weapons": {
      "type": "array",
      "items": {"$ref": "#/$defs/weapon"}
    }
  },
  "$defs": {
    "weapon": {
      "type": "object",
      "required": [
        "name",
        "type_code",
        "accuracy",
        "concealment",
        "availability",
        "damage",
        "ammo_type",
        "weapon_range_m",
        "magazine_capacity",
        "cadence_full_auto",
        "reliability"
      ],
      "properties": {
        "name": {"type": "string"},
        "type_code": {"type": "string"},
        "accuracy": {"type": "integer"},
        "concealment": {"type": "string"},
        "availability": {"type": "string"},
        "damage": {"type": "string"},
        "ammo_type": {"type": "string"},
        "weapon_range_m": {"type": "integer"},
        "magazine_capacity": {"type": "integer"},
        "cadence_full_auto": {"type": "integer"},
        "reliability": {"type": "string"},
		"class": {"type": "string"},
		"price": {"type": "number"} 
      }
    }
  }
}