{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Equipment Dataset",
  "type": "object",
  "required": ["data"],
  "properties": {
    "$id": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "author": { "type": "string" },
    "type": { "type": "string" },
    "data": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "modifiers": { "type": "object", "additionalProperties": { "type": "string" } },
          "modifierGroup": { "$ref": "#/definitions/modifierGroup" },
          "types": { "type": "object", "additionalProperties": { "type": "string" } },
          "list": { "$ref": "#/definitions/itemMap" },
          "items": { "$ref": "#/definitions/itemMap" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "modifierGroup": {
      "type": "object",
      "required": ["id", "label", "appliesTo", "options"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "label", "multiplier"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "multiplier": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "itemMap": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/definitions/item" },
          { "type": "string" }
        ]
      }
    },
    "item": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "note": { "type": "string" },
        "effect": { "type": "string" },
        "price": { "type": ["string", "number"] },
        "cost": { "type": ["string", "number"] },
        "value": { "type": ["string", "number"] }
      },
      "additionalProperties": true
    }
  }
}
