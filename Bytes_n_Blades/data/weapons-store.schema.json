{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local/fnff/weapons-store.schema.json",
  "title": "FNFF Weapon Store",
  "type": "object",
  "required": ["version", "weapons"],
  "properties": {
    "$id": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "version": {"const": 1},
    "locale": {"enum": ["en-US", "pt-BR"]},
    "source": {"type": "string"},
    "weapons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/weapon"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringOrArray": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        }
      ]
    },
    "numberOrArray": {
      "oneOf": [
        {"type": "number"},
        {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number"}
        }
      ]
    },
    "weapon": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type_code",
        "accuracy",
        "concealment",
        "availability",
        "damage",
        "ammo_type",
        "weapon_range_m",
        "magazine_capacity",
        "cadence_full_auto",
        "reliability"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^weapon_[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "type_code": {"type": "string", "minLength": 1},
        "accuracy": {"$ref": "#/$defs/numberOrArray"},
        "concealment": {"$ref": "#/$defs/stringOrArray"},
        "availability": {"type": "string", "minLength": 1},
        "damage": {"$ref": "#/$defs/stringOrArray"},
        "ammo_type": {"$ref": "#/$defs/stringOrArray"},
        "weapon_range_m": {"$ref": "#/$defs/numberOrArray"},
        "magazine_capacity": {"$ref": "#/$defs/numberOrArray"},
        "cadence_full_auto": {"$ref": "#/$defs/numberOrArray"},
        "reliability": {"$ref": "#/$defs/stringOrArray"},
        "class": {"type": "string", "minLength": 1},
        "price": {"type": "number", "minimum": 0},
        "price_max": {"type": "number", "minimum": 0},
        "Note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
