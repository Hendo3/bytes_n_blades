{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local/bytes-and-blades/ammo.schema.json",
  "title": "Bytes & Blades Ammo and Add-ons",
  "type": "object",
  "required": ["version", "locale", "source", "items"],
  "properties": {
    "$id": { "type": "string" },
    "version": { "const": 1 },
    "locale": { "enum": ["en-US", "pt-BR"] },
    "title": { "type": "string" },
    "source": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "name", "description", "price"],
        "properties": {
          "id": { "type": "string", "pattern": "^ammo_[a-z0-9_]+$" },
          "category": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "price": { "type": "number", "minimum": 0 },
          "price_max": { "type": "number", "minimum": 0 },
          "price_label": { "type": "string" },
          "compatibility": { "type": "string" },
          "legacyIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
