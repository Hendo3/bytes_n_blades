{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chip Skill Rates Dataset",
  "type": "object",
  "required": ["$id", "title", "version", "data"],
  "properties": {
    "$id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "data": {
      "type": "object",
      "required": ["mram", "aptr", "visual_recognition"],
      "additionalProperties": { "$ref": "#/definitions/chipType" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "chipType": {
      "type": "object",
      "required": ["label", "sections"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/section" }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["id", "label", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/rate" }
        }
      },
      "additionalProperties": false
    },
    "rate": {
      "type": "object",
      "required": ["id", "skill"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "skill": { "type": "string", "minLength": 1 },
        "pricePerLevel": { "type": ["number", "null"], "minimum": 0 },
        "levelPrices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0 }
        },
        "note": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["pricePerLevel"] },
        { "required": ["levelPrices"] }
      ],
      "allOf": [
        {
          "if": {
            "required": ["pricePerLevel"],
            "properties": { "pricePerLevel": { "type": "null" } }
          },
          "then": { "required": ["note"] }
        }
      ],
      "additionalProperties": false
    }
  }
}
