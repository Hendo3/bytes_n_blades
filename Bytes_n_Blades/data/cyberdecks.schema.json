{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schema_version", "locale", "decks", "builder"],
  "properties": {
    "schema_version": { "type": "string" },
    "locale": { "enum": ["en-US", "pt-BR"] },
    "decks": {
      "type": "array",
      "minItems": 27,
      "items": { "$ref": "#/definitions/deck" }
    },
    "builder": {
      "type": "object",
      "required": ["base_stats", "limits", "chassis", "upgrades", "connections", "options", "external_products", "source"],
      "properties": {
        "base_stats": { "type": "object" },
        "limits": { "type": "object" },
        "chassis": { "type": "array", "minItems": 7, "items": { "$ref": "#/definitions/chassis" } },
        "upgrades": { "type": "object" },
        "connections": { "type": "array", "minItems": 3 },
        "options": { "type": "array", "minItems": 21, "items": { "$ref": "#/definitions/option" } },
        "external_products": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/option" } },
        "source": { "type": "object" },
        "editorial_notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "priceModel": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["fixed", "formula", "black_market_markup", "barter", "not_for_sale"] },
        "amount": { "type": "number", "minimum": 0 },
        "base": { "type": "number", "minimum": 0 },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    },
    "bibliographicSource": {
      "type": "object",
      "required": ["book", "pages"],
      "properties": {
        "book": { "type": "string", "minLength": 1 },
        "pages": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "deck": {
      "type": "object",
      "required": ["id", "name", "description", "price", "price_model", "cpu", "memory", "speed", "data_wall", "portable", "cellular", "armor_sp", "options", "availability", "catalog_scope", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "price": { "type": ["number", "null"], "minimum": 0 },
        "price_model": { "$ref": "#/definitions/priceModel" },
        "price_qualifier": { "enum": ["exact", "approximate", "special"] },
        "cpu": { "type": ["integer", "null"], "minimum": 1 },
        "memory": { "type": "integer", "minimum": 1 },
        "speed": { "type": "integer" },
        "data_wall": { "type": ["integer", "null"], "minimum": 0 },
        "portable": { "type": "boolean" },
        "cellular": { "type": "boolean" },
        "armor_sp": { "type": ["integer", "null"], "minimum": 0 },
        "options": { "type": "array", "items": { "type": "string" } },
        "availability": { "enum": ["retail", "restricted", "quote", "not_for_sale", "referee_approval"] },
        "catalog_scope": { "enum": ["standard", "netrunner_conversion"] },
        "unspecified": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/definitions/bibliographicSource" },
        "reprint_source": { "$ref": "#/definitions/bibliographicSource" }
      },
      "additionalProperties": true
    },
    "chassis": {
      "type": "object",
      "required": ["id", "name", "price", "portable", "cellular", "armor_sp"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number", "minimum": 0 },
        "portable": { "type": "boolean" },
        "cellular": { "type": "boolean" },
        "armor_sp": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "option": {
      "type": "object",
      "required": ["id", "name", "pricing"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "pricing": { "enum": ["fixed", "per_unit", "range", "percentage"] },
        "price": { "type": "number", "minimum": 0 },
        "price_per_unit": { "type": "number", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0 },
        "choices": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
